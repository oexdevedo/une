# Porta do servidor backend
PORT=3001
NODE_ENV=production

# Chave secreta de autenticação JWT (gere uma string aleatória forte com 'openssl rand -hex 32')
JWT_SECRET=sua_chave_jwt_secreta_e_segura_aqui

# Origens permitidas para CORS (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001

# Configuração de Inteligência Artificial (OpenAI, Gemini, Custom ou AWS Bedrock)
AI_PROVIDER=openai
AI_BASE_URL=
AI_API_KEY=sua_chave_aqui
AI_MODEL=gpt-4o-mini

# AWS Bedrock
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=sua_chave_access_key_aqui
AWS_SECRET_ACCESS_KEY=sua_chave_secret_key_aqui
BEDROCK_MODEL_ID=openai.gpt-oss-20b-1:0

# Política Anti-Ban (opcional - valores abaixo são os padrões)
# ANTIBAN_ENABLED=true
# Canais: WHATSAPP, TELEGRAM_USER (conta de usuário), TELEGRAM_BOT
# ANTIBAN_WHATSAPP_MIN_DELAY_MS=3000
# ANTIBAN_WHATSAPP_MAX_DELAY_MS=8000
# ANTIBAN_WHATSAPP_PER_MINUTE=10
# ANTIBAN_WHATSAPP_PER_HOUR=120
# ANTIBAN_WHATSAPP_PER_DAY=800
# ANTIBAN_TELEGRAM_USER_MIN_DELAY_MS=1500
# ANTIBAN_TELEGRAM_USER_MAX_DELAY_MS=4000
# ANTIBAN_TELEGRAM_USER_PER_MINUTE=15
# ANTIBAN_TELEGRAM_USER_PER_HOUR=300
# ANTIBAN_TELEGRAM_USER_PER_DAY=1500
# ANTIBAN_TELEGRAM_BOT_MIN_DELAY_MS=500
# ANTIBAN_TELEGRAM_BOT_MAX_DELAY_MS=1500
# ANTIBAN_TELEGRAM_BOT_PER_MINUTE=30
# ANTIBAN_TELEGRAM_BOT_PER_HOUR=1000
# ANTIBAN_TELEGRAM_BOT_PER_DAY=5000
